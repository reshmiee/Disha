# ─────────────────────────────────────────────────────────────────────────────
# DISHA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

DEBUG=True

# Comma-separated list of allowed hosts (production: your domain)
ALLOWED_HOSTS=*

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite for dev.
# For production PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/disha_db

# ── AI Keys ───────────────────────────────────────────────────────────────────
# Groq — Safety Chatbot (MARG) + Dilemma Solver (SWAR)
# Free tier available at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# xAI / Grok — Vent Space (SWAR)
# Get key at: https://x.ai/api
XAI_API_KEY=xai_your_xai_key_here
XAI_BASE_URL=https://api.x.ai/v1

# ── CORS (Production) ─────────────────────────────────────────────────────────
# Add your deployed frontend URL here in production
# FRONTEND_URL=https://yourdisha.app
